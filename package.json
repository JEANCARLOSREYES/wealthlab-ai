{
  "name": "wealthlab-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "python3 scripts/start.py",
    "build:pages": "tsc -b && vite build --mode pages",
    "test": "node --import tsx --test src/browser/tests/*.test.ts",
    "publish:build": "pnpm build:pages && node scripts/prepare-pages.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "papaparse": "^5.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
